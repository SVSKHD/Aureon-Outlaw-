        "action",
        "go",
        "reason",
        "ts"
      ],
      "reporting_required": [
        "pattern_scan",
        "config_fingerprint",
        "account_mode",
        "research_scale",
        "research_reference_lot",
        "research_daily_price_move",
        "research_daily_usd",
        "research_monthly_usd",
        "plan_stop_distance_price",
        "research_translation",
        "calibration_status",
        "scout_mirroring",
        "setup_outcomes"
      ],
      "analysis_required": [
        "multi_timeframe",
        "treatment",
        "session_target",
