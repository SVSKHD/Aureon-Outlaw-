      "decision_summary_fields": [
        "signal_go",
        "trade_action",
        "scout_verdict",
        "target_verdict",
        "calibration_status",
        "reason"
      ],
      "session_target_fields": [
        "session_target_price_move",
        "target_price",
        "required_price_move",
        "expected_direction",
        "target_verdict",
        "remaining_session_minutes",
        "required_velocity",
        "current_velocity",
        "session_range",
        "session_range_consumed",
        "estimated_remaining_range",
        "nearest_blocking_liquidity",
        "distance_to_blocking_liquidity",
        "historical_samples",
        "historical_target_hit_rate",
        "historical_fakeout_rate",
        "target_reason"
      ],
      "pattern_scan_fields": [
        "status",
        "bar_time",
        "bars",
        "age_seconds",
        "executor",
        "last_scan_ms"
      ],
      "scouts_required": [
        "session",
        "leader",
        "verdict",
        "strength",
        "market_speed",
        "guidance",
        "buy",
        "sell",
        "displacement",
        "velocity",
        "velocity_direction",
        "pace_range",
        "pace_window_minutes",
        "strength_source",
        "calibration_sessions",
        "pace_calibrated"
