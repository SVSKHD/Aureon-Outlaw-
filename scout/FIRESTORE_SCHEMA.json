        "schema_version",
        "date",
        "session",
        "symbol",
        "updated_ts",
        "price",
        "structure",
        "pa",
        "scouts",
        "plan",
        "final",
        "reporting",
        "analysis",
        "patterns",
        "sweeps",
        "levels"
      ],
