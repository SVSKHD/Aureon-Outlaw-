        "max_points": 240
      },
      "price_required": [
        "bid",
        "ask",
        "spread",
        "freshness",
        "broker_utc_offset_hours"
      ],
      "broker_clock_fields": [
        "offset_hours",
        "offset_seconds",
        "residual_seconds",
        "raw_delta_seconds",
        "source",
        "server",
        "measured_at"
      ],
      "veto_fields": [
        "veto",
        "active",
        "detail",
        "flips_when"
      ]
