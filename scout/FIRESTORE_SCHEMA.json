    "days": {
      "required": [
        "date",
        "sessions"
      ]
    },
    "events": {
      "required": [
        "ts",
        "kind",
        "date",
        "payload",
        "discord_eligible",
        "posted_discord"
      ],
      "posted_discord_values": [
        true,
        false,
        null
      ]
